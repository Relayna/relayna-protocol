{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskEnvelope",
  "description": "Canonical v1.0 task on the wire. The Spooltail adapter adds the work event ID.",
  "$ref": "#/$defs/taskFields",
  "required": ["task_id", "payload", "created_at", "spec_version"],
  "properties": {
    "service": { "type": "string" },
    "task_type": { "type": "string" },
    "correlation_id": { "type": "string" }
  },
  "examples": [
    {
      "task_id": "task-42",
      "event_id": "task",
      "payload": { "number": 21 },
      "created_at": "2026-11-27T14:49:35Z",
      "service": "calculations",
      "task_type": "double",
      "correlation_id": "request-19",
      "spec_version": "1.0"
    }
  ],
  "$defs": {
    "newHttpTaskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9]",
      "not": { "pattern": "[^A-Za-z0-9._~-]" }
    },
    "taskFields": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "service": { "type": ["string", "null"] },
        "task_type": { "type": ["string", "null"] },
        "correlation_id": { "type": ["string", "null"] },
        "spec_version": { "const": "1.0" }
      }
    },
    "submitTask": {
      "title": "TaskSubmission",
      "$ref": "#/$defs/taskFields",
      "required": ["task_id", "payload"],
      "properties": {
        "task_id": { "$ref": "#/$defs/newHttpTaskId" },
        "spec_version": { "default": "1.0" }
      },
      "unevaluatedProperties": false
    },
    "spooltailWorkRecord": {
      "title": "Spooltail Work Record",
      "$ref": "#",
      "required": ["event_id"],
      "properties": {
        "event_id": { "const": "task" }
      }
    }
  }
}
