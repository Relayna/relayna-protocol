{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway Task Usage",
  "type": "object",
  "required": ["service", "task_id", "request_count", "input_tokens", "output_tokens", "total_tokens", "estimated_cost_usd", "observations", "truncated"],
  "properties": {
    "service": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "request_count": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/usageObservation" }
    },
    "truncated": { "type": "boolean" }
  },
  "examples": [
    {
      "service": "reference",
      "task_id": "task-42",
      "request_count": 0,
      "input_tokens": 0,
      "output_tokens": 0,
      "total_tokens": 0,
      "estimated_cost_usd": null,
      "observations": [],
      "truncated": false
    }
  ],
  "$defs": {
    "usageObservation": {
      "type": "object",
      "required": ["request_id", "trace_id", "created_at", "route", "provider", "model", "http_method", "endpoint_path", "status_code", "run_id", "input_tokens", "output_tokens", "total_tokens", "estimated_cost_usd"],
      "properties": {
        "request_id": { "type": "string" },
        "trace_id": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "route": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "http_method": { "type": ["string", "null"] },
        "endpoint_path": { "type": ["string", "null"] },
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "run_id": { "type": ["string", "null"], "description": "The SDK attempt ID when recorded by a trusted execution path." },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
