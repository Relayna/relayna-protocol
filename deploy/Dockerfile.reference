# syntax=docker/dockerfile:1
FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
WORKDIR /build/sdk
COPY --from=sdk pyproject.toml uv.lock README.md ./
COPY --from=sdk src/ ./src/
COPY --from=spooltail python/ /build/spooltail/
RUN pip install --no-cache-dir uv==0.13.9 \
    && uv sync --locked --no-dev --no-editable \
    && uv pip install --python /build/sdk/.venv/bin/python /build/spooltail uvicorn==0.44.0
ENV PATH=/build/sdk/.venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /reference
COPY --from=sdk examples/spooltail_service.py ./
USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "spooltail_service:app", "--host", "0.0.0.0", "--port", "8080"]
